# Copy this file to .env. Sign-in is done by hand in a browser window
# (run `python -m deepseek.auth`), so no credentials are stored here.

# --- Optional ---
# DEEPSEEK_PROFILE_DIR=session/profile   # reuse an existing signed-in Chrome profile
# HOST=127.0.0.1
# PORT=8000
# RATE_LIMIT_PER_MINUTE=30               # per-client-IP limit on /v1 endpoints

# --- Session expiry handling ---
# If the session dies and can't be refreshed automatically, fail fast with a 503
# instead of opening a browser window mid-request. Log in by hand with:
#   python -m deepseek.auth
# SERVER_INTERACTIVE_LOGIN=0

# Background refresher: re-capture the token from the browser profile on a timer.
# Keep the interval below deepseek.auth.SESSION_MAX_AGE (6h).
# SESSION_REFRESH_ENABLED=1
# SESSION_REFRESH_INTERVAL=18000         # seconds (5h)

# Playwright channel for the background (headless) refresh. The light bundled
# "chromium-headless-shell" uses less RAM; fall back to "chrome" if it can't read
# Chrome-encrypted cookies. Set the fallback empty to disable it.
# REFRESH_BROWSER_CHANNEL=chromium-headless-shell
# REFRESH_BROWSER_CHANNEL_FALLBACK=chrome

# --- Tool-call truncation handling ---
# DeepSeek's web output limit can cut a large tool call off mid-JSON. When that
# happens the bridge resumes the same thread and asks the model to continue,
# concatenating slices until the call parses. Set how many continuations to try.
# TOOLCALL_MAX_CONTINUATIONS=3

# Dump the raw model reply to the log whenever a tool call can't be parsed.
# DEBUG_TOOLCALLS=1
